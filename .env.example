# Control-plane database. Lists salons. It does not hold appointments.
PLATFORM_DATABASE_URL="postgresql://redlady:redlady@localhost:5432/redlady_platform?schema=public"

# Used only while Prisma generates the tenant client. Each salon then gets its own URL.
TENANT_DATABASE_URL="postgresql://redlady:redlady@localhost:5432/redladyspa?schema=public"

# Same Postgres server, used to CREATE DATABASE for a new salon.
TENANT_ADMIN_URL="postgresql://redlady:redlady@localhost:5432/postgres?schema=public"

AUTH_SECRET="dev-only-change-me-red-lady-spa-2026"
DEFAULT_TENANT_SLUG="red-lady-spa"
DEMO_HINTS="true"

# local writes photo files under data/photos. Use s3 when the bucket exists.
STORAGE_DRIVER="local"
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
# PHOTO_KMS_KEY_ID=

SMS_DRIVER="console"
CRON_SECRET="dev-cron-secret"

