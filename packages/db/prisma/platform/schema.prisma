// Control plane. One database lists every salon and where its data lives.
// This is the platform schema (platform.prisma).

generator client {
  provider      = "prisma-client-js"
  output        = "../../src/generated/platform"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DATABASE_URL")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
}

model PlatformUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

model Tenant {
  id                   String             @id @default(cuid())
  slug                 String             @unique
  name                 String
  status               TenantStatus       @default(PROVISIONING)
  subscriptionStatus   SubscriptionStatus @default(TRIAL)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  dbName               String
  dbHost               String
  databaseUrl          String?
  connectionSecretArn  String?
  includedLocations    Int                @default(1)
  extraLocationPriceCents Int             @default(4900)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  domains              TenantDomain[]
}

model TenantDomain {
  id        String   @id @default(cuid())
  hostname     String   @unique
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationSlug String?
  createdAt    DateTime @default(now())
}
