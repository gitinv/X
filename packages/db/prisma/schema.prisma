generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  TECHNICIAN
  FRONT_DESK
  OWNER
  PLATFORM_ADMIN
}

model Tenant {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  stripeCustomerId String?
  subscriptionStatus String? @default("trial")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users        User[]
  appointments Appointment[]
  products     Product[]
  technicians  Technician[]
  clients      Client[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(CUSTOMER)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Technician {
  id        String   @id @default(cuid())
  name      String
  role      String?
  avatar    String?
  specialties String[]
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]
}

model Client {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  notes     String?
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]
}

model Appointment {
  id             String   @id @default(cuid())
  clientName     String
  clientPhone    String?
  serviceName    String
  technicianId   String?
  technician     Technician? @relation(fields: [technicianId], references: [id])
  date           String
  time           String
  status         String   @default("Confirmed")
  price          Float
  paymentStatus  String   @default("Unpaid")
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

model Product {
  id            String   @id @default(cuid())
  name          String
  category      String
  price         Float
  description   String?
  image         String?
  stock         Int      @default(0)
  lowStockAlert Int      @default(5)
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
